# Copy this file to .env and fill with real values. DO NOT commit .env

# JWT secret used to sign auth tokens
JWT_SECRET=your_jwt_secret_here

# Supabase (Postgres) configuration
SUPABASE_URL=https://your-supabase-instance.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: external URL Render provides (used for keep-alive pings)
RENDER_EXTERNAL_URL=https://your-render-app.onrender.com

# Node environment and port
NODE_ENV=production
PORT=5000

# (Optional) API key used by AI/GROQ/third-party routes
GROQ_API_KEY=your_groq_api_key_here
